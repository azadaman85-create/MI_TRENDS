# Google sign-in for the storefront account pages.
# Create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud console,
# add your site to "Authorised JavaScript origins" (e.g. http://localhost:3000),
# then copy the client ID here as .env.local and restart the dev server.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Super admin for /admin/login.
# The panel has no backend, so it compares a salted SHA-256 digest in the browser.
# Never put the plaintext password here — generate salt + hash with:
#   node -e 'const c=require("crypto");const s=c.randomBytes(16).toString("hex");console.log("salt",s);console.log("hash",c.createHash("sha256").update(s+":"+process.argv[1]).digest("hex"))' 'YOUR_PASSWORD'
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_NAME=
NEXT_PUBLIC_ADMIN_PASSWORD_SALT=
NEXT_PUBLIC_ADMIN_PASSWORD_HASH=
