# Google sign-in for the storefront account pages.
# Create an OAuth 2.0 Client ID (type: Web application) in the Google Cloud console,
# add your site to "Authorised JavaScript origins" (e.g. http://localhost:3000),
# then copy the client ID here as .env.local and restart the dev server.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Super admin for /admin/login. Verified server-side in app/api/admin/login —
# deliberately NOT prefixed with NEXT_PUBLIC_, so the hash never reaches the browser.
# Never put the plaintext password here — generate salt + hash with:
#   node -e 'const c=require("crypto");const s=c.randomBytes(16).toString("hex");console.log("salt",s);console.log("hash","scrypt:"+c.scryptSync(process.argv[1],s,64).toString("hex"))' 'YOUR_PASSWORD'
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
ADMIN_SESSION_SECRET=

# Razorpay Standard Checkout. Get keys from https://dashboard.razorpay.com/app/keys.
#
# The key prefix IS the mode — there is no separate switch:
#   rzp_test_...  test mode, no real money
#   rzp_live_...  live mode, real money
# Use test keys locally and on preview deploys; live keys only on the production
# environment. The app refuses to start with test keys when VERCEL_ENV=production.
#
# NEXT_PUBLIC_RAZORPAY_KEY_ID is inlined at build time, so changing it on the host
# requires a REDEPLOY — saving the variable alone does nothing.
# KEY_SECRET must stay server-only — never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook (dashboard → Settings → Webhooks). This is a secret YOU choose
# there, NOT the API key secret. Without it a customer who closes the tab right after
# paying leaves a charged order stuck in "awaiting_payment".
# URL to register: https://<your-domain>/api/webhooks/razorpay   event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# MongoDB Atlas — customer accounts and orders. Create a cluster + database user at
# https://cloud.mongodb.com, then copy its connection string here.
MONGODB_URI=
MONGODB_DB_NAME=mitrends
# Signs the customer session cookie. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
CUSTOMER_SESSION_SECRET=

# Order confirmation emails over Gmail SMTP.
# SMTP_PASSWORD is a Google App Password (16 chars), not the account password:
# https://myaccount.google.com/apppasswords (needs 2-Step Verification enabled)
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=MI TRENDS
NEXT_PUBLIC_SITE_URL=https://mitrends.co.in
